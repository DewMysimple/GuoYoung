{
  "manifest_version": 3,
  "name": "Mysimple · 网站收藏",
  "short_name": "Mysimple",
  "version": "1.1.72",
  "description": "可搜索、分组和拖拽排序的个人网站收藏新标签页。",
  "permissions": [
    "favicon",
    "activeTab",
    "bookmarks",
    "search",
    "storage"
  ],
  "optional_permissions": [
    "history"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "添加网站或管理浏览器书签",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "offline_enabled": true
}
